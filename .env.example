SENTRY_DSN="your-dsn"

# set this to false to prevent search engines from indexing the website
# default to allow indexing for seo safety
ALLOW_INDEXING="true"

# Sanity write token. Only needed to accept reader comments; reads are public.
# Create one in manage.sanity.io with "Editor" rights on project nws8g1b1.
SANITY_API_WRITE_TOKEN="your-write-token"
